# ===== Competition Radar 环境变量模板 =====
# 复制为 .env 后按需填写。此文件只含占位值，不含真实密钥。
# .env 已被 .gitignore 忽略，不要提交真实凭证。

# 研究服务模式：
#   auto            —— 安装了 gpt-researcher 且配置了 LLM Key 时用真实引擎，否则回退 mock
#   mock            —— 离线样例，不访问外部服务（联调 / 演示 / 测试推荐使用）
#   fixture         —— 回放 5 份真实通知快照（离线，六键正文）
#   real            —— 即时联网搜索（Bocha 搜索 + 抓正文 + DeepSeek 抽取）
#   gpt_researcher  —— 强制使用真实引擎
RESEARCHER_MODE=auto
RESEARCHER_REPORT_TYPE=research_report
RESEARCHER_TIMEOUT_SECONDS=300
MAX_SEARCH_ROUNDS=2
LOG_LEVEL=INFO

# 本校名称（用于过滤外校校赛：只推荐本校可参加的比赛）
USER_SCHOOL=华南师范大学

# ===== 国产大模型（全链路国产化；填 DEEPSEEK_API_KEY 即启用真实 31 字段抽取）=====
# 不填则离线走「规范候选 + 规则抽取」，仍可跑通完整链路，只是不联网调模型。
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com/chat/completions

# 换其它国产厂商（OpenAI 兼容端点）：
#   通义 Qwen:  DEEPSEEK_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
#   智谱 GLM:   DEEPSEEK_BASE_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions
#   月之暗面:   DEEPSEEK_BASE_URL=https://api.moonshot.cn/v1/chat/completions

# ===== 联网搜索（抓正文免 key；搜索后端需 key）=====
# SEARCH_PROVIDER: bocha（国产，推荐）/ tavily / duckduckgo（免 key，较脆弱）
SEARCH_PROVIDER=bocha
BOCHA_API_KEY=
TAVILY_API_KEY=
SEARCH_MAX_RESULTS=5

# ===== 真实 GPT Researcher 需要的凭证（可选，用国产模型时可指向 DeepSeek 兼容端点）=====
OPENAI_API_KEY=
TAVILY_API_KEY=
LLM_PROVIDER=openai
